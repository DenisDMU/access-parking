PORT=8000
DATABASE_URL=sqlite:///./access.db
API_KEY=change-me
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bascule GLOBALE mock/réel (valeur par défaut pour les 5 services ci-dessous).
USE_MOCKS=true

VEHICLES_SERVICE_URL=http://localhost:8001
BOOKING_SERVICE_URL=http://localhost:8002
PARKING_SERVICE_URL=http://localhost:8003
PRICING_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005

# Bascules INDIVIDUELLES (optionnelles) : si définies, prennent le dessus sur
# USE_MOCKS pour CE service uniquement — pratique pour brancher chaque
# microservice de l'équipe dès qu'il est prêt, un par un, sans attendre les
# 4 autres. Laissez-les commentées tant que le service mocké convient.
# VEHICLES_USE_MOCK=false
# BOOKING_USE_MOCK=false
# PARKING_USE_MOCK=false
# PRICING_USE_MOCK=false
# PAYMENT_USE_MOCK=false

AI_MODEL_NAME=fake-vision-v1

# Diffusion des événements vers les autres microservices de l'équipe (fan-out HTTP, best-effort)
EVENT_SUBSCRIBERS_URLS=http://localhost:9001/webhooks/access,http://localhost:9002/webhooks/access
EVENT_PUBLISH_TIMEOUT_MS=1000

# Mécanisme de publication des événements : "webhook" (fan-out HTTP ci-dessus,
# par défaut) ou "rabbitmq" (voir infrastructure/events/rabbitmq_event_publisher.py)
EVENT_PUBLISHER=webhook
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Rate limiting sur POST /access/requests (voir slowapi)
RATE_LIMIT_ACCESS_REQUESTS=20/minute
