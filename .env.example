PORT=8000
# SQLite en local. En production : URL Postgres de Neon (postgresql://...?sslmode=require),
# saisie dans Render > Environment — sinon les données sont effacées à chaque redémarrage.
DATABASE_URL=sqlite:///./access.db
API_KEY=change-me
# Clé des bornes client (/borne) : ne permet que le passage d'un véhicule.
# Vide = pas de clé borne. Au moins 16 caractères, différente d'API_KEY.
BORNE_API_KEY=
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bascule GLOBALE mock/réel (valeur par défaut pour les 5 services ci-dessous).
USE_MOCKS=true

VEHICLES_SERVICE_URL=https://parking-vehicles.onrender.com
BOOKING_SERVICE_URL=http://localhost:8002
PARKING_SERVICE_URL=http://localhost:8003
PRICING_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=https://payment-xp8n.onrender.com
# Clé fournie EN PRIVÉ par l'équipe Payment (jamais dans Git). Vide = pas
# d'en-tête X-API-Key envoyé.
PAYMENT_API_KEY=
# Idem pour les autres services (envoyée dans X-API-Key si renseignée).
# Parking l'EXIGE depuis le 18/11/2026 : sans elle, toute entrée est refusée
# avec « Service Parking indisponible ».
PARKING_API_KEY=
PRICING_API_KEY=
VEHICLES_API_KEY=

# Bascule INDIVIDUELLE (optionnelle) : si définie, prend le dessus sur
# USE_MOCKS pour Booking uniquement. Laissez-la commentée tant que le service
# mocké convient.
# (Vehicles, Pricing, Parking et Payment n'ont plus de mock ni de bascule :
# branchés en dur sur les vrais services depuis VEHICLES_SERVICE_URL/
# PRICING_SERVICE_URL/PARKING_SERVICE_URL/PAYMENT_SERVICE_URL, voir README
# section 5/16.)
# BOOKING_USE_MOCK=false

AI_MODEL_NAME=fake-vision-v1

# Diffusion des événements vers les autres microservices de l'équipe (fan-out HTTP, best-effort)
EVENT_SUBSCRIBERS_URLS=http://localhost:9001/webhooks/access,http://localhost:9002/webhooks/access
EVENT_PUBLISH_TIMEOUT_MS=1000

# Mécanisme de publication des événements : "webhook" (fan-out HTTP ci-dessus,
# par défaut) ou "rabbitmq" (voir infrastructure/events/rabbitmq_event_publisher.py)
EVENT_PUBLISHER=webhook
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Rate limiting sur POST /access/requests (voir slowapi)
RATE_LIMIT_ACCESS_REQUESTS=20/minute
