    {
      "name": "Errors — edge cases (\"tests foireux\")",
      "description": "Requêtes volontairement invalides pour vérifier que les erreurs sont propres : jamais de stack trace, toujours un JSON {detail: ...} avec le bon code HTTP.",
      "item": [
        {
          "name": "401 — no API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Body = {detail: ...}, no stack trace', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('detail');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('Traceback');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"AA-111-AA\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "requests"]
            },
            "description": "En-tête X-API-Key absent : doit être refusé avant même de toucher au workflow métier."
          },
          "response": []
        },
        {
          "name": "422 — invalid plate format",
          "event": [
            {
              "listen": "test",
              "script": {
