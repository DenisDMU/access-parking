    {
      "name": "Access — Entry",
      "item": [
        {
          "name": "Entry — standard vehicle (authorized, Parking assignment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Authorized', () => pm.expect(body.authorization.result).to.eql(1));",
                  "pm.collectionVariables.set('requestId', body.requestId);",
                  "pm.collectionVariables.set('vehicleId', body.vehicleId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"AA-111-AA\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3,\n  \"photoBase64\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "requests"]
            },
            "description": "Entrée d'un véhicule 4 roues standard, sans réservation : Parking lui attribue une place, autorisation accordée."
          },
          "response": []
