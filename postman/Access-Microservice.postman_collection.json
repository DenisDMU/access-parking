            "description": "Véhicule handicapé sans justificatif PMR valide : résultat CONFIRMATION_REQUISE (3), pas un refus direct."
          },
          "response": []
        },
        {
          "name": "Entrée — PMR avec justificatif (autorisé)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plaque\": \"EE-555-EE\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3,\n  \"photoBase64\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
