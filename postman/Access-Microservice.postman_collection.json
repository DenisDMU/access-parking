{
  "info": {
    "_postman_id": "b3a1f7b0-2222-4000-8000-access00coll1",
    "name": "Access — Microservice Parking",
    "description": "Collection de test pour le microservice Access (workflow entrée/sortie parking). Importer aussi l'environnement 'Access — Local' fourni à côté.\n\nRegistre de plaques de démo câblé dans le mock Vehicles :\n- AA-111-AA : 4 roues standard\n- BB-222-BB : 2 roues\n- CC-333-CC : 4 roues XL\n- DD-444-DD : 4 roues électrique\n- EE-555-EE : 4 roues handicapé, AVEC justificatif PMR\n- FF-666-FF : 4 roues handicapé, SANS justificatif PMR (confirmation requise)\n- GG-777-GG : 4 roues standard, a une réservation active (Booking)\n- HH-888-HH : 4 roues standard, paiement toujours refusé à la sortie\n- toute autre plaque : inconnue de Vehicles (rejet)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Healthcheck, non authentifié."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Access — Entrée",
      "item": [
        {
          "name": "Entrée — véhicule standard (autorisé, attribution Parking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Autorisé', () => pm.expect(body.autorisation.resultat).to.eql(1));",
                  "pm.collectionVariables.set('demandeId', body.demandeId);",
                  "pm.collectionVariables.set('vehiculeId', body.vehiculeId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plaque\": \"AA-111-AA\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3,\n  \"photoBase64\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "requests"]
            },
            "description": "Entrée d'un véhicule 4 roues standard, sans réservation : Parking lui attribue une place, autorisation accordée."
          },
          "response": []
        },
        {
          "name": "Entrée — avec réservation active (Booking)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plaque\": \"GG-777-GG\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3,\n  \"photoBase64\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "requests"]
            },
            "description": "Ce véhicule a une réservation active chez Booking (mock) : la place réservée est utilisée directement, sans appel à Parking."
          },
          "response": []
        },
        {
          "name": "Entrée — PMR sans justificatif (confirmation requise)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plaque\": \"FF-666-FF\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3,\n  \"photoBase64\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "requests"]
