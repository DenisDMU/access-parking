        {
          "name": "429 — rate limit exceeded (run via Collection Runner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 429) {",
                  "  pm.test('429 Too Many Requests', () => pm.response.to.have.status(429));",
                  "} else {",
                  "  console.log('Status ' + pm.response.code + ' — re-run via Runner with 25+ iterations to trigger 429 (default limit 20/minute).');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"AA-111-AA\",\n  \"type\": 1,\n  \"date\": \"2026-09-02T10:15:00Z\",\n  \"source\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "requests"]
            },
            "description": "Un seul appel ne suffit pas à déclencher le rate limit (RATE_LIMIT_ACCESS_REQUESTS=20/minute par défaut). Pour voir un vrai 429 : clic droit sur ce dossier > Run folder > 25+ itérations, délai 0 ms."
          },
          "response": []
        }
      ]
